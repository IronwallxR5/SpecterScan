# SpecterScan Backend — Environment Template
# Copy to .env and fill in your actual keys.

# Server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
HOST=127.0.0.1
PORT=8000

# Pinecone (required)
PINECONE_API_KEY=your_pinecone_api_key_here

# Groq API keys — primary + up to 3 fallbacks (all optional after key 1)
GROQ_API_KEY=your_groq_key_1
GROQ_API_KEY_2=your_groq_key_2
GROQ_API_KEY_3=your_groq_key_3
GROQ_API_KEY_4=your_groq_key_4
